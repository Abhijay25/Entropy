# Entropy environment template. Copy to .env (gitignored) and fill in secrets:
#   cp .env.example .env
# Never commit .env or put any of these values in browser code (no VITE_* secrets).

API_HOST=127.0.0.1
API_PORT=3001

# --- Daytona ---------------------------------------------------------------
# API key from https://app.daytona.io (Dashboard -> API Keys).
DAYTONA_API_KEY=
# Leave blank for the default https://app.daytona.io/api.
DAYTONA_API_URL=
# Team account region.
DAYTONA_TARGET=eu
# Blank uses Daytona's default snapshot; npm run doctor records its Node version.
DAYTONA_SNAPSHOT=
# Daytona CLI used for `daytona mcp start`. It does not read DAYTONA_API_KEY;
# authenticate it once with: daytona login --api-key <your key>
DAYTONA_CLI_PATH=daytona

# --- Nosana ----------------------------------------------------------------
NOSANA_BASE_URL=https://inference.nosana.com/v1
NOSANA_API_KEY=
# Pick an ID from GET /models; npm run doctor lists the available ones.
NOSANA_MODEL=

# --- Neo4j -----------------------------------------------------------------
# Aura: paste the neo4j+s:// URI and password. Local: docker compose up -d --wait,
# then NEO4J_URI=bolt://127.0.0.1:7687 and any NEO4J_PASSWORD (compose reads it).
NEO4J_URI=
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# --- Entropy ---------------------------------------------------------------
# Full SHA of a commit whose payload was prepared with:
#   npm run prepare:payload -- <full sha>
# Blank in development mode uses `npm run prepare:payload -- --development`.
ENTROPY_SOURCE_SHA=
# At most 2; the live demo needs quota for two simultaneous sandboxes.
ENTROPY_MAX_SANDBOXES=2
# live: every sponsor required (the acceptance demo).
# development: explicitly labeled substitutes for whatever is unset
# (in-memory graph, local process trials, working-tree payload).
ENTROPY_MODE=development
