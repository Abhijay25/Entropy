## 4. Shared TypeScript Contract (`shared/types.ts`)

Both teammates code against these interfaces so integration has zero friction:

```typescript
export type NodeHealthStatus = 'HEALTHY' | 'DEGRADED' | 'DOWN';

export interface ServiceNode {
  id: string;
  name: string;
  type: 'Service' | 'Datastore';
  port: number;
  status: NodeHealthStatus;
  latencyP95Ms?: number;
  errorRate?: number; // 0.0 to 1.0
}

export interface DependencyEdge {
  source: string;
  target: string;
  relationship: 'CALLS' | 'READS' | 'WRITES' | 'VERIFY_TOKEN' | 'CASCADED_TO';
  hasTimeout?: boolean;
  hasCircuitBreaker?: boolean;
  cascadeLatencyMs?: number;
}

export interface TopologyGraph {
  nodes: ServiceNode[];
  edges: DependencyEdge[];
}

export type FaultType = 'LATENCY_SPIKE' | 'SERVICE_KILL' | 'ERROR_RATE';

export interface ChaosHypothesis {
  id: string;
  title: string;
  question: string;
  targetServiceId: string;
  faultType: FaultType;
  faultParams: {
    delayMs?: number;
    errorRate?: number;
    durationSec: number;
  };
  predictedBlastRadiusIds: string[];
  rationale: string;
  cypherQueryUsed: string;
}

export interface ServiceMetric {
  serviceId: string;
  status: NodeHealthStatus;
  requestsTotal: number;
  errorsTotal: number;
  errorRate: number;
  latencyP50Ms: number;
  latencyP95Ms: number;
  latencyP99Ms: number;
}

