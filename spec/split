  sandboxId: string;
  executionMode: 'daytona' | 'local-fallback';
  faultCommandExecuted: string;
  baselineMetrics: Record<string, ServiceMetric>;
  chaosMetrics: Record<string, ServiceMetric>;
  postPatchMetrics?: Record<string, ServiceMetric>;
  actualBlastRadiusIds: string[];
  postPatchBlastRadiusIds?: string[];
